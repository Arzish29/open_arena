# Copy to .env and edit. Vite only exposes variables that start with VITE_.

# Where the RAG backend runs. Empty = same origin (use a proxy or serve the app from the backend).
VITE_API_BASE=http://localhost:8000

# true (default) = use the built-in mocks for Pip and the quiz, no backend needed.
# false = call POST /api/chat and POST /api/quiz/question on VITE_API_BASE.
VITE_USE_MOCK=true

# Dev only: forward /api/* from the Vite dev server to the backend (avoids CORS).
# Use it with VITE_API_BASE empty.
# API_PROXY=http://localhost:8000
